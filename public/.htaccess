<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    
    RewriteRule ^ocular-emergencies/?$ https://shubhanueyehospital.com/ [R=301,L] [R=301,L]
    RewriteRule ^about-our-clinic/?$ https://shubhanueyehospital.com/ [R=301, L]
    RewriteRule ^dr-bhanu-p-s-pangtey-2/?$ https://shubhanueyehospital.com/doctors/dr-bhanu-pratap-singh-pangte [R=301,L]
    
    RewriteRule ^(ocular-emergencies|schedule|our-specialists|lid-surgery|home-service|landing-page-2|shopping-cart|services-2|new-appointment|wp-login\.php)/?$ https://shubhanueyehospital.com/? [R=301,L]

 

    # ============ 2. Gallery fix ============
    RewriteRule ^gallery-2/?$ https://shubhanueyehospital.com/gallery [R=301,L]

    # ============ 3. Jis URL me "contact" ho -> /contact-us ============
    # (/contact-us aur /contact-us/ ko chhod kar, warna loop ban jayega)
    RewriteCond %{REQUEST_URI} !^/contact-us/?$ [NC]
    RewriteRule contact https://shubhanueyehospital.com/contact-us [R=301,L,NC]

    # ============ 4. Baaki purane pages -> Home ============
    RewriteRule ^(doctortry|dry-eye-problem|dr-shubha-r-k-pangtey|tooth-fairy-traditions|eye-tumors|appointment|testimonials|thyroid-eye-disease|neuro-ophthalmology|orbital-surgery|artificial-prosthetic-eyes|treatment-of-watering-eyes|retinal-surgery-injection|retinal-detachment-symptoms|retina-detachment-lakshan|cataract-symptoms-causes-treatment|blurred-vision-after-cataract-surgery-pco|motiyabind-cataract-lakshan-karan-ilaj|motiyabind-surgery-baad-dhundhli-nazar-pco|our-serviceswith-home|medclinic-layout-main-slider|ophthalmology-home-page-img-2-2|02-quicklinks-working-time|03-quicklinks-appointment|01-quicklinks-location|06-quicklinks-emergency-case|fda-approves-generic-version-of-cyclosporine-ophthalmic-emulsion-as-dry-eye-treatment|scientists-construct-a-first-single-cell-atlas-of-human-porcine-eyes-maps-genes-involved-in-eye-disorders|extremely-preterm-babies-have-higher-risk-of-eye-problems-as-adults|nei-supported-study-to-focus-on-causes-of-cataracts)/?$ https://shubhanueyehospital.com/ [R=301,L]

    # Category, tag, author aur date archive pages -> Home
    RewriteRule ^(category|tag|author)(/.*)?$ https://shubhanueyehospital.com/ [R=301,L]
    RewriteRule ^20[0-9]{2}(/.*)?$ https://shubhanueyehospital.com/ [R=301,L]
    
    # ============ Laravel default rules ============
    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>